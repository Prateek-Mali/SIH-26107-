# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=your-key-from-aistudio.google.com
GEMINI_MODEL=gemini-flash-latest          # Claude Code: replace with the newest Flash model printed by client.models.list()
GEMINI_ROUTER_MODEL=gemini-flash-lite-latest
GEMINI_EMBED_MODEL=gemini-embedding-001

# Fallback when Gemini quota/network fails (install Ollama, then: ollama pull <model>)
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_URL=http://localhost:11434

QDRANT_PATH=index/qdrant
TOP_K=8
