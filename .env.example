# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=your-key-from-aistudio.google.com
# GEMINI_API_KEY_2=optional-second-key   # used automatically when the first hits its quota
GEMINI_MODEL=gemini-3.8-flash
GEMINI_ROUTER_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
# When a model hits its quota (429) or is overloaded (503), the next model is used (quotas are per model).
GEMINI_MODEL_FALLBACKS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash
GEMINI_ROUTER_FALLBACKS=gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-3.5-flash

# Fallback when Gemini quota/network fails (install Ollama, then: ollama pull <model>)
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_URL=http://localhost:11434

QDRANT_PATH=index/qdrant
TOP_K=8
