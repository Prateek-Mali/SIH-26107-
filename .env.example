# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=your-key-from-aistudio.google.com
# GEMINI_API_KEY_2=optional-second-key   # used automatically when the first hits its quota
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_ROUTER_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
# Embeddings: local = bge-m3 inside Python (free, no daily limit, Hindi + English)
EMBED_PROVIDER=local
# When a model hits its quota (429) or is overloaded (503), the next model is used (quotas are per model).
GEMINI_MODEL_FALLBACKS=gemini-3.1-flash-lite,gemini-3-flash-preview,gemini-3.6-flash,gemini-3.8-flash
GEMINI_ROUTER_FALLBACKS=gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-3.5-flash

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_SMALL_MODEL=openai/gpt-oss-20b


QDRANT_PATH=index/qdrant
TOP_K=8

# Local reranker (ONNX via fastembed)
RERANK_MODEL=BAAI/bge-reranker-base

# on = reasoning agent with tools (app/agent.py); off = the old linear pipeline
AGENT_MODE=on
# the one answer model per run: gemini (GEMINI_MODEL) or groq (GROQ_MODEL); others only as a visible FALLBACK
ANSWER_PROVIDER=gemini

# login database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB=bis_assistant

# emails allowed to re-index (POST /admin/reindex), comma-separated
ADMIN_EMAILS=
# other websites allowed to call the API (the web UI on this server needs nothing here)
ALLOWED_ORIGINS=
