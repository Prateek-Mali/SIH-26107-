# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=your-key-from-aistudio.google.com
# GEMINI_API_KEY_2=optional-second-key   # used automatically when the first hits its quota
GEMINI_MODEL=gemini-3.6-flash
GEMINI_ROUTER_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
# Embeddings: ollama = local bge-m3 (free, no daily limit, Hindi+English); gemini = 1000/day on the free tier
EMBED_PROVIDER=ollama
OLLAMA_EMBED_MODEL=bge-m3
# When a model hits its quota (429) or is overloaded (503), the next model is used (quotas are per model).
GEMINI_MODEL_FALLBACKS=gemini-3.8-flash,gemini-3-flash-preview,gemini-2.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_ROUTER_FALLBACKS=gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-3.5-flash

# Answer providers in order: Gemini -> Groq (free key: https://console.groq.com) -> local Ollama
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback when Gemini quota/network fails (install Ollama, then: ollama pull <model>)
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_URL=http://localhost:11434

QDRANT_PATH=index/qdrant
TOP_K=8
